[Unit]
Description=UDM SATA boot guard (hide dead eMMC, keep SCSI env, mask usd)
After=local-fs.target
Before=usd.service usdbd.service
ConditionPathExists=/persistent/udm-sata/bin/udm-sata-guard

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/persistent/udm-sata/bin/udm-sata-guard

[Install]
WantedBy=multi-user.target
